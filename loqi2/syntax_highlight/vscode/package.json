{
  "name": "loqi-syntax",
  "displayName": "Loqi Language Support",
  "description": "Syntax highlighting, bracket matching, indentation, and folding for Loqi and TPG files.",
  "version": "2.1.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "loqi",
        "aliases": [
          "Loqi",
          "loqi"
        ],
        "extensions": [
          ".loqi",
          ".tpg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loqi",
        "scopeName": "source.loqi",
        "path": "./syntaxes/loqi.tmLanguage.json"
      }
    ]
  }
}
