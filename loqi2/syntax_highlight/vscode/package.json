{
  "name": "loqi-syntax",
  "displayName": "Loqi Language Support",
  "description": "Syntax highlighting, bracket matching, and folding for the Loqi DSL.",
  "version": "2.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "loqi",
        "aliases": ["Loqi", "loqi"],
        "extensions": [".loqi"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loqi",
        "scopeName": "source.loqi",
        "path": "./syntaxes/loqi.tmLanguage.json"
      }
    ]
  }
}
