{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loqi",
  "scopeName": "source.loqi",
  "fileTypes": ["loqi"],
  "patterns": [
    { "include": "#main" }
  ],
  "repository": {
    "main": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#metaBlock" },
        { "include": "#curlyBlock" },
        { "include": "#parens" },
        { "include": "#angleParams" },
        { "include": "#declarations" },
        { "include": "#qualifiedEntities" },
        { "include": "#metadataKeys" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#identifiers" }
      ]
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.block.loqi",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.loqi",
          "match": "//.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.loqi",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#stringEscapes" }]
        },
        {
          "name": "string.quoted.triple.single.loqi",
          "begin": "'''",
          "end": "'''",
          "patterns": [{ "include": "#stringEscapes" }]
        },
        {
          "name": "string.quoted.double.loqi",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#stringEscapes" }]
        },
        {
          "name": "string.quoted.single.loqi",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#stringEscapes" }]
        }
      ]
    },

    "stringEscapes": {
      "patterns": [
        {
          "name": "constant.character.escape.loqi",
          "match": "\\\\[btnfr\"'\\\\]"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.loqi",
          "match": "\\b(?:if|else|while|find|findExtreme|forAny|forAll|among|with|ask|switch|trivial|tuple|conclude|out|as)\\b"
        },
        {
          "name": "keyword.declaration.loqi",
          "match": "\\b(?:class|obj|enum|prop|rel|tpg|values|meta|for|var)\\b"
        },
        {
          "name": "keyword.operator.word.loqi",
          "match": "\\b(?:and|or|not|is|to)\\b"
        },
        {
          "name": "storage.modifier.loqi",
          "match": "\\b(?:linear|partial|opposite|transitive|between|closer|further|hyp|mutex)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.loqi",
          "match": "\\b(?:int|double|bool|string)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.loqi",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.loqi",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.outcome.loqi",
          "match": "\\b(?:correct|error)\\b"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.loqi",
          "match": "(?<![A-Za-z0-9_`])(?:\\d*\\.\\d+(?:[eE][+-]?\\d+)?|\\d+[eE][+-]?\\d+|(?:0|[1-9]\\d*)[dD])(?![A-Za-z0-9_`])"
        },
        {
          "name": "constant.numeric.integer.loqi",
          "match": "(?<![A-Za-z0-9_`])(?:0|[1-9]\\d*)(?![A-Za-z0-9_`])"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.loqi",
          "match": "\\+=>|=>|->|==|!=|>=|<=|>|<|=|\\?|:|\\.|,|;"
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.tpg.loqi",
          "match": "\\b(tpg)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.loqi" },
            "2": { "name": "entity.name.type.loqi" }
          }
        },
        {
          "name": "meta.declaration.class.loqi",
          "match": "\\b(class|enum|obj)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.loqi" },
            "2": { "name": "entity.name.type.loqi" }
          }
        },
        {
          "name": "meta.declaration.member.loqi",
          "match": "\\b(prop|rel)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.loqi" },
            "2": { "name": "entity.name.function.loqi" }
          }
        },
        {
          "name": "meta.declaration.variable.loqi",
          "match": "\\b(var)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?::|=|,|$))",
          "captures": {
            "1": { "name": "keyword.declaration.loqi" },
            "2": { "name": "variable.other.definition.loqi" }
          }
        }
      ]
    },

    "qualifiedEntities": {
      "patterns": [
        {
          "name": "constant.other.class-ref.loqi",
          "match": "\\bclass\\s*:\\s*(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "constant.other.object-ref.loqi",
          "match": "\\bobj\\s*:\\s*(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "constant.other.enum-value.loqi",
          "match": "\\b(?:`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*(?:`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)\\b"
        }
      ]
    },

    "metadataKeys": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.loqi",
          "match": "\\b(?:`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?:\\.|=))"
        }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.loqi",
          "match": "`[^`\\s]+`|\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.language.special.loqi",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },

    "metaBlock": {
      "name": "meta.annotation.section.loqi",
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.section.meta.begin.loqi" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.section.meta.end.loqi" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#metaBlock" },
        { "include": "#curlyBlock" },
        { "include": "#parens" },
        { "include": "#angleParams" },
        { "include": "#declarations" },
        { "include": "#qualifiedEntities" },
        { "include": "#metadataKeys" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#identifiers" }
      ]
    },

    "curlyBlock": {
      "name": "meta.block.curly.loqi",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.block.begin.loqi" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.loqi" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#metaBlock" },
        { "include": "#curlyBlock" },
        { "include": "#parens" },
        { "include": "#angleParams" },
        { "include": "#declarations" },
        { "include": "#qualifiedEntities" },
        { "include": "#metadataKeys" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#identifiers" }
      ]
    },

    "parens": {
      "name": "meta.group.parens.loqi",
      "begin": "\\(",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.loqi" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.loqi" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#metaBlock" },
        { "include": "#curlyBlock" },
        { "include": "#parens" },
        { "include": "#angleParams" },
        { "include": "#declarations" },
        { "include": "#qualifiedEntities" },
        { "include": "#metadataKeys" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#identifiers" }
      ]
    },

    "angleParams": {
      "name": "meta.group.angle.loqi",
      "begin": "(?<![<>=!\\-+])<(?!(?:=|<))",
      "beginCaptures": {
        "0": { "name": "punctuation.section.angle.begin.loqi" }
      },
      "end": "(?<!-)>(?![>=])",
      "endCaptures": {
        "0": { "name": "punctuation.section.angle.end.loqi" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#metaBlock" },
        { "include": "#curlyBlock" },
        { "include": "#parens" },
        { "include": "#angleParams" },
        { "include": "#qualifiedEntities" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#identifiers" }
      ]
    }
  }
}
