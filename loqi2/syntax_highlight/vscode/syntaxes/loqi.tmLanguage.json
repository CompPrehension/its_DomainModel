{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loqi",
  "scopeName": "source.loqi",
  "fileTypes": [
    "loqi",
    "tpg"
  ],
  "patterns": [
    {
      "include": "#main"
    }
  ],
  "repository": {
    "main": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#expressionReferences"
        },
        {
          "include": "#qualifiedEntities"
        },
        {
          "include": "#metadataKeys"
        },
        {
          "include": "#braces"
        },
        {
          "include": "#brackets"
        },
        {
          "include": "#parens"
        },
        {
          "include": "#angleParams"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#variables"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "nested": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#expressionReferences"
        },
        {
          "include": "#qualifiedEntities"
        },
        {
          "include": "#metadataKeys"
        },
        {
          "include": "#braces"
        },
        {
          "include": "#brackets"
        },
        {
          "include": "#parens"
        },
        {
          "include": "#angleParams"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#variables"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.loqi",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.loqi"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.loqi"
            }
          }
        },
        {
          "name": "comment.line.double-slash.loqi",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.loqi",
          "begin": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.loqi"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.loqi"
            }
          },
          "patterns": [
            {
              "include": "#stringEscapes"
            }
          ]
        },
        {
          "name": "string.quoted.triple.single.loqi",
          "begin": "'''",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.loqi"
            }
          },
          "end": "'''",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.loqi"
            }
          },
          "patterns": [
            {
              "include": "#stringEscapes"
            }
          ]
        },
        {
          "name": "string.quoted.double.loqi",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.loqi"
            }
          },
          "end": "\"|(?=$)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.loqi"
            }
          },
          "patterns": [
            {
              "include": "#stringEscapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.loqi",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.loqi"
            }
          },
          "end": "'|(?=$)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.loqi"
            }
          },
          "patterns": [
            {
              "include": "#stringEscapes"
            }
          ]
        },
        {
          "name": "string.quoted.other.backtick.loqi",
          "begin": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.loqi"
            }
          },
          "end": "`|(?=$)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.loqi"
            }
          }
        }
      ]
    },
    "stringEscapes": {
      "patterns": [
        {
          "name": "constant.character.escape.loqi",
          "match": "\\\\[btnfr\"'\\\\]"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.tpg.loqi",
          "match": "\\b(tpg)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.graph.loqi"
            },
            "2": {
              "name": "entity.name.type.graph.loqi"
            }
          }
        },
        {
          "name": "meta.declaration.class.loqi",
          "match": "\\b(class)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)(?:\\s*(:)\\s*(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.class.loqi"
            },
            "2": {
              "name": "entity.name.type.class.loqi"
            },
            "3": {
              "name": "punctuation.separator.inheritance.loqi"
            },
            "4": {
              "name": "entity.other.inherited-class.loqi"
            }
          }
        },
        {
          "name": "meta.declaration.enum.loqi",
          "match": "\\b(enum)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.enum.loqi"
            },
            "2": {
              "name": "entity.name.type.enum.loqi"
            }
          }
        },
        {
          "name": "meta.declaration.object.loqi",
          "match": "\\b(obj)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)(\\s*(:)\\s*(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.object.loqi"
            },
            "2": {
              "name": "entity.name.instance.loqi"
            },
            "4": {
              "name": "punctuation.separator.type.loqi"
            },
            "5": {
              "name": "entity.name.type.class.loqi"
            }
          }
        },
        {
          "name": "meta.declaration.property.loqi",
          "match": "\\b(prop)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.property.loqi"
            },
            "2": {
              "name": "entity.name.variable.property.loqi"
            }
          }
        },
        {
          "name": "meta.declaration.relationship.loqi",
          "match": "\\b(rel)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.relationship.loqi"
            },
            "2": {
              "name": "entity.name.function.relationship.loqi"
            }
          }
        },
        {
          "name": "meta.declaration.fragment.loqi",
          "match": "\\b(fragment)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.fragment.loqi"
            },
            "2": {
              "name": "entity.name.function.fragment.loqi"
            }
          }
        },
        {
          "name": "meta.declaration.variable.loqi",
          "match": "\\b(var)\\s+(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?::|=|,|with|$))",
          "captures": {
            "1": {
              "name": "keyword.declaration.variable.loqi"
            },
            "2": {
              "name": "variable.other.definition.loqi"
            }
          }
        }
      ]
    },
    "expressionReferences": {
      "patterns": [
        {
          "name": "meta.expression.variable.special.loqi",
          "match": "(\\$)(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.loqi"
            },
            "2": {
              "name": "variable.other.special.loqi"
            }
          }
        },
        {
          "name": "meta.expression.property-access.loqi",
          "match": "(\\.)(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dot.loqi"
            },
            "2": {
              "name": "variable.other.member.property.loqi"
            }
          }
        },
        {
          "name": "meta.expression.relationship-access.loqi",
          "match": "(->|=>|\\+=>|-=>)\\s*(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.relationship.loqi"
            },
            "2": {
              "name": "entity.name.function.relationship.loqi"
            }
          }
        },
        {
          "name": "meta.function-call.loqi",
          "match": "\\b(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)(\\s*(?::)\\s*(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*))*\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.loqi"
            },
            "3": {
              "name": "entity.name.function.loqi"
            }
          }
        }
      ]
    },
    "qualifiedEntities": {
      "patterns": [
        {
          "name": "meta.expression.class-literal.loqi",
          "match": "\\b(class)\\s*(:)\\s*(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.class.loqi"
            },
            "2": {
              "name": "punctuation.separator.key-value.loqi"
            },
            "3": {
              "name": "entity.name.type.class.loqi"
            }
          }
        },
        {
          "name": "meta.expression.object-literal.loqi",
          "match": "\\b(obj)\\s*(:)\\s*(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.object.loqi"
            },
            "2": {
              "name": "punctuation.separator.key-value.loqi"
            },
            "3": {
              "name": "entity.name.instance.loqi"
            }
          }
        },
        {
          "name": "meta.enum-value-reference.loqi",
          "match": "\\b(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.enum.loqi"
            },
            "2": {
              "name": "punctuation.separator.key-value.loqi"
            },
            "3": {
              "name": "constant.other.enum-value.loqi"
            }
          }
        }
      ]
    },
    "metadataKeys": {
      "patterns": [
        {
          "name": "meta.metadata.property.loqi",
          "match": "\\b(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)(\\s*(\\.)\\s*(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*))?\\s*(?==)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.namespace.loqi"
            },
            "3": {
              "name": "punctuation.accessor.dot.loqi"
            },
            "4": {
              "name": "entity.other.attribute-name.loqi"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.expression.loqi",
          "match": "\\b(?:if|else|find|findExtreme|forAny|forAll|among|with|as)\\b"
        },
        {
          "name": "keyword.control.tree.loqi",
          "match": "\\b(?:while|cycle|agg|ask|switch|trivial|tuple|conclude|out|merge)\\b"
        },
        {
          "name": "keyword.declaration.loqi",
          "match": "\\b(?:class|obj|enum|prop|rel|tpg|values|meta|for|var|fragment)\\b"
        },
        {
          "name": "keyword.operator.word.loqi",
          "match": "\\b(?:and|or|not|is|to|compare)\\b"
        },
        {
          "name": "storage.modifier.relationship.loqi",
          "match": "\\b(?:linear|partial|opposite|transitive|between|closer|further)\\b"
        },
        {
          "name": "storage.modifier.aggregation.loqi",
          "match": "\\b(?:hyp|mutex)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.loqi",
          "match": "\\b(?:int|double|bool|string)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.loqi",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.loqi",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.outcome.loqi",
          "match": "\\b(?:correct|error)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.loqi",
          "match": "(?<![A-Za-z0-9_`])(?:\\d*\\.\\d+(?:[eE][+-]?\\d+)?|\\d+[eE][+-]?\\d+|(?:0|[1-9]\\d*)[dD])(?![A-Za-z0-9_`])"
        },
        {
          "name": "constant.numeric.integer.loqi",
          "match": "(?<![A-Za-z0-9_`])(?:0|[1-9]\\d*)(?![A-Za-z0-9_`])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.relationship.loqi",
          "match": "\\+=>|-=>|=>|->|-\\[|\\]->"
        },
        {
          "name": "keyword.operator.comparison.loqi",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.assignment.loqi",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.loqi",
          "match": "\\+"
        },
        {
          "name": "keyword.operator.ternary.loqi",
          "match": "\\?"
        },
        {
          "name": "punctuation.separator.loqi",
          "match": ":|\\.|,|;"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.special.loqi",
          "match": "\\$(`[^`\\s]+`|[A-Za-z_][A-Za-z0-9_]*)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.identifier.loqi",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "braces": {
      "name": "meta.block.curly.loqi",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.curly.loqi"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.curly.loqi"
        }
      },
      "patterns": [
        {
          "include": "#nested"
        }
      ]
    },
    "brackets": {
      "name": "meta.group.brackets.loqi",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.group.begin.square.loqi"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.group.end.square.loqi"
        }
      },
      "patterns": [
        {
          "include": "#nested"
        }
      ]
    },
    "parens": {
      "name": "meta.group.parens.loqi",
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.group.begin.parens.loqi"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.group.end.parens.loqi"
        }
      },
      "patterns": [
        {
          "include": "#nested"
        }
      ]
    },
    "angleParams": {
      "name": "meta.group.angle.loqi",
      "begin": "(?<![<>=!\\-+])<(?!(?:=|<))",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.group.begin.angle.loqi"
        }
      },
      "end": "(?<!-)>(?![>=])",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.group.end.angle.loqi"
        }
      },
      "patterns": [
        {
          "include": "#nested"
        }
      ]
    }
  }
}
