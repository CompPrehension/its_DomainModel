{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loqi",
  "scopeName": "source.loqi",
  "fileTypes": ["loqi"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#class-declaration" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.loqi",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.loqi" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.loqi" }
          }
        },
        {
          "name": "comment.line.double-slash.loqi",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.loqi" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.loqi",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#escape-sequences" }
          ]
        },
        {
          "name": "string.quoted.triple.loqi",
          "begin": "'''",
          "end": "'''",
          "patterns": [
            { "include": "#escape-sequences" }
          ]
        },
        {
          "name": "string.quoted.double.loqi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#escape-sequences" }
          ]
        },
        {
          "name": "string.quoted.single.loqi",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#escape-sequences" }
          ]
        }
      ]
    },
    "escape-sequences": {
      "patterns": [
        {
          "name": "constant.character.escape.loqi",
          "match": "\\\\[btnfr\"'\\\\]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.loqi",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?[dD]?\\b"
        },
        {
          "name": "constant.numeric.float.loqi",
          "match": "\\b\\d+[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.loqi",
          "match": "\\b\\d+[dD]\\b"
        },
        {
          "name": "constant.numeric.integer.loqi",
          "match": "\\b(0|[1-9]\\d*)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.loqi",
          "match": "\\b(class|obj|enum|tree|prop|rel|var|meta|values)\\b"
        },
        {
          "name": "keyword.control.loqi",
          "match": "\\b(if|else|while|for|cycle|agg|ask|switch|tuple|trivial|with|conclude|out)\\b"
        },
        {
          "name": "keyword.operator.loqi",
          "match": "\\b(is|as|and|or|not|find|findExtreme|forAny|forAll|among|compare)\\b"
        },
        {
          "name": "keyword.relationship.loqi",
          "match": "\\b(linear|partial|opposite|transitive|between|closer|further|to)\\b"
        },
        {
          "name": "keyword.aggregation.loqi",
          "match": "\\b(and|or|mutex|hyp)\\b"
        },
        {
          "name": "keyword.for.loqi",
          "match": "\\b(for)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.loqi",
          "match": "\\b(int|double|bool|string)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.loqi",
          "match": "=|\\+=>|=>|->|\\?"
        },
        {
          "name": "keyword.operator.comparison.loqi",
          "match": "==|!=|<=|>=|<|>|:"
        },
        {
          "name": "keyword.operator.logical.loqi",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "punctuation.separator.loqi",
          "match": "[;,]"
        },
        {
          "name": "punctuation.bracket.loqi",
          "match": "[{}\\[\\]()]"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.loqi",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.loqi",
          "match": "\\b(null)\\b"
        },
        {
          "name": "constant.language.outcome.loqi",
          "match": "\\b(correct|error)\\b"
        }
      ]
    },
    "class-declaration": {
      "patterns": [
        {
          "begin": "\\b(class)\\s+",
          "end": "(?=\\s*[:{]|\\s*$)",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.loqi" }
          },
          "patterns": [
            {
              "name": "entity.name.class.loqi",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            }
          ]
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.loqi",
          "match": "`[^\\s`]+`"
        },
        {
          "name": "variable.other.loqi",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.loqi",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    }
  }
}