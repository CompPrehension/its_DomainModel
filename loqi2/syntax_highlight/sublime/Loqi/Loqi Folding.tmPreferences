<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Loqi Folding</string>
    <key>scope</key>
    <string>source.loqi</string>
    <key>settings</key>
    <dict>
        <key>foldingStartMarker</key>
        <string>(\{\s*$|\[\s*$|\(\s*$|^\s*//\s*#?region\b)</string>
        <key>foldingStopMarker</key>
        <string>(^\s*\}|^\s*\]|^\s*\)|^\s*//\s*#?endregion\b)</string>
    </dict>
</dict>
</plist>
